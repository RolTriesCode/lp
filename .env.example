# Public Supabase Data API configuration. The publishable key is designed for
# browser use and is still constrained by PostgreSQL Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Monitoring is opt-in. Keep both flags false in local development. Sentry's
# DSN is public by design; the source-map token below is server/build only.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SPEED_INSIGHTS_SAMPLE_RATE=0.2

# Sentry source-map upload configuration. Set only in CI/Vercel build secrets.
# Never prefix the auth token with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# Existing server-only AI provider variables remain configured in .env.local.
# Never add privileged database keys to NEXT_PUBLIC_* variables.
